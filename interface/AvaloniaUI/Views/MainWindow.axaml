<Window
    x:Class="THUAI9_Avalonia.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:THUAI9_Avalonia.Views"
    xmlns:vm="using:THUAI9_Avalonia.ViewModels"
    xmlns:models="using:THUAI9_Avalonia.Models"
    xmlns:ToolTip="using:Avalonia.Controls"
    mc:Ignorable="d"
    x:Name="MainWindowElement"
    Title="THUAI9 调试界面"
    Width="1280"
    Height="800"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.SecondaryButton">
            <Setter Property="Background" Value="#E1DFDD" />
            <Setter Property="Foreground" Value="#201F1E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.SecondaryButton:pointerover">
            <Setter Property="Background" Value="#C7C6C5" />
        </Style>
        <Style Selector="Button.SecondaryButton:pressed">
            <Setter Property="Background" Value="#8D8C8C" />
        </Style>

        <Style Selector="Button.PlayButton">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.PlayButton:pointerover">
            <Setter Property="Background" Value="#F3F3F3" />
            <Setter Property="BorderBrush" Value="#B8B8B8" />
        </Style>
        <Style Selector="Button.PlayButton:pressed">
            <Setter Property="Background" Value="#E1E1E1" />
            <Setter Property="BorderBrush" Value="#9D9D9D" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="470,*" Margin="10">
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,10,0">
            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,96,120" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 x:Name="PlaybackPathBox"
                                 Text="{Binding PlaybackVM.FilePath, Mode=TwoWay}"
                                 PlaceholderText="选择 .thuaipb 回放文件或粘贴路径" />
                        <Button Grid.Column="1"
                                Content="选择文件"
                                Click="BrowsePlayback_Click"
                                Classes="SecondaryButton"
                                Height="35" />
                        <Button Grid.Column="2"
                                Content="加载回放"
                                Command="{Binding LoadPlaybackCommand}"
                                CommandParameter="{Binding Text, ElementName=PlaybackPathBox}"
                                Classes="SecondaryButton"
                                Height="35" />
                    </Grid>

                    <Border Background="#E8E8E8" CornerRadius="5" Padding="8" Margin="0,5,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <Button Content="播放"
                                    Command="{Binding PlaybackVM.PlayCommand}"
                                    Width="56"
                                    Height="35"
                                    VerticalAlignment="Center"
                                    Classes="PlayButton"
                                    ToolTip.Tip="播放" />

                            <Button Content="暂停"
                                    Command="{Binding PlaybackVM.PauseCommand}"
                                    Width="56"
                                    Height="35"
                                    VerticalAlignment="Center"
                                    Classes="PlayButton"
                                    ToolTip.Tip="暂停" />

                            <Button Content="停止"
                                    Command="{Binding PlaybackVM.StopCommand}"
                                    Width="56"
                                    Height="35"
                                    VerticalAlignment="Center"
                                    Classes="PlayButton"
                                    ToolTip.Tip="停止" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlaybackVM.PlaybackTimeText}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding PlaybackVM.PlaybackSpeedLabels}"
                                          SelectedIndex="{Binding PlaybackVM.PlaybackSpeedIndex, Mode=TwoWay}"
                                          Width="76"
                                          Height="34"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PlaybackVM.FrameProgressText}"
                                           FontSize="11"
                                           Foreground="#666666"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="*,*">
                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,4,4" Background="#FFF0F0" CornerRadius="5" Padding="8" BorderBrush="#FFCCCC" BorderThickness="1" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="3">
                        <TextBlock Grid.Row="0" Text="队伍 1" FontSize="15" FontWeight="Bold" Foreground="Red" />
                        <TextBlock Grid.Row="1" Text="{Binding TeamScores[0], StringFormat='得分：{0}'}" FontSize="12" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Team1Characters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CharacterViewModel">
                                        <Border Background="White" CornerRadius="3" Padding="5" Margin="0,2">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding PlayerText}" FontSize="10" Foreground="Gray" Margin="6,0,0,0" />
                                                </Grid>
                                                <TextBlock Text="{Binding HealthText}" FontSize="10" Foreground="Gray" />
                                                <TextBlock Text="{Binding ActiveState}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Coordinates}" FontSize="10" Foreground="Gray" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Margin="4,0,0,4" Background="#F0F0FF" CornerRadius="5" Padding="8" BorderBrush="#CCCCFF" BorderThickness="1" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="3">
                        <TextBlock Grid.Row="0" Text="队伍 2" FontSize="15" FontWeight="Bold" Foreground="Blue" />
                        <TextBlock Grid.Row="1" Text="{Binding TeamScores[1], StringFormat='得分：{0}'}" FontSize="12" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Team2Characters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CharacterViewModel">
                                        <Border Background="White" CornerRadius="3" Padding="5" Margin="0,2">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding PlayerText}" FontSize="10" Foreground="Gray" Margin="6,0,0,0" />
                                                </Grid>
                                                <TextBlock Text="{Binding HealthText}" FontSize="10" Foreground="Gray" />
                                                <TextBlock Text="{Binding ActiveState}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Coordinates}" FontSize="10" Foreground="Gray" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Margin="0,4,4,0" Background="#F0FFF0" CornerRadius="5" Padding="8" BorderBrush="#CCFFCC" BorderThickness="1" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="3">
                        <TextBlock Grid.Row="0" Text="队伍 3" FontSize="15" FontWeight="Bold" Foreground="Green" />
                        <TextBlock Grid.Row="1" Text="{Binding TeamScores[2], StringFormat='得分：{0}'}" FontSize="12" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Team3Characters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CharacterViewModel">
                                        <Border Background="White" CornerRadius="3" Padding="5" Margin="0,2">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding PlayerText}" FontSize="10" Foreground="Gray" Margin="6,0,0,0" />
                                                </Grid>
                                                <TextBlock Text="{Binding HealthText}" FontSize="10" Foreground="Gray" />
                                                <TextBlock Text="{Binding ActiveState}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Coordinates}" FontSize="10" Foreground="Gray" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Margin="4,4,0,0" Background="#FFFFF0" CornerRadius="5" Padding="8" BorderBrush="#FFFFCC" BorderThickness="1" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="3">
                        <TextBlock Grid.Row="0" Text="队伍 4" FontSize="15" FontWeight="Bold" Foreground="Orange" />
                        <TextBlock Grid.Row="1" Text="{Binding TeamScores[3], StringFormat='得分：{0}'}" FontSize="12" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Team4Characters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CharacterViewModel">
                                        <Border Background="White" CornerRadius="3" Padding="5" Margin="0,2">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding PlayerText}" FontSize="10" Foreground="Gray" Margin="6,0,0,0" />
                                                </Grid>
                                                <TextBlock Text="{Binding HealthText}" FontSize="10" Foreground="Gray" />
                                                <TextBlock Text="{Binding ActiveState}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Coordinates}" FontSize="10" Foreground="Gray" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Margin="0,5,0,0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" Text="对局摘要" FontWeight="Bold" Margin="0,0,0,6" />

                    <Border Grid.Row="1" Background="#F7F7F7" CornerRadius="5" Padding="10" Margin="0,0,0,8" MaxHeight="230" ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="6">
                            <ItemsControl ItemsSource="{Binding TeamOverviews}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TeamOverviewItem">
                                        <Grid ColumnDefinitions="58,*" Margin="0,1">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Header}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding TeamId, Converter={StaticResource TeamIdToColorConverter}}" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{Binding SummaryText}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding MemberUuidText}"
                                                           FontSize="9"
                                                           Foreground="#666666"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="1" Background="#22000000" Margin="0,2" />

                            <TextBlock Text="{Binding BuildingSummary}" FontSize="10" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ResourceSummary}" FontSize="10" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ObjectiveSummary}" FontSize="10" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MarketSummary}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2" RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="事件日志" FontWeight="Bold" Margin="0,0,0,3" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="160">
                            <ItemsControl ItemsSource="{Binding LogConsoleVM.LogEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LogEntry">
                                        <Grid ColumnDefinitions="80,Auto,*" Margin="0,1">
                                            <TextBlock Grid.Column="0" Text="{Binding Timestamp}" FontSize="9" Foreground="Gray" />
                                            <Border Grid.Column="1" CornerRadius="2" Padding="2,0" Margin="5,0">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Level, Converter={StaticResource LevelToColorConverter}, FallbackValue=LightGray}" />
                                                </Border.Background>
                                                <TextBlock Text="{Binding Level}" FontSize="8" Foreground="White" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="10" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="5" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" FontWeight="SemiBold" />
                </Border>

                <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="5" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="地图图例" FontWeight="Bold" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding MapLegendItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" ItemWidth="120" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:LegendItem">
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Border Width="15" Height="15" Background="{Binding Color}" BorderBrush="{Binding Stroke}" BorderThickness="{Binding BorderThickness}" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding Description}" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="5" BorderBrush="Gray" BorderThickness="1">
                <local:MapView x:Name="MapView" DataContext="{Binding MapVM}" />
            </Border>
        </Grid>
    </Grid>
</Window>
