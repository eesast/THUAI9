<Window
    x:Class="THUAI9_Avalonia.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:THUAI9_Avalonia.Views"
    xmlns:vm="using:THUAI9_Avalonia.ViewModels"
    xmlns:models="using:THUAI9_Avalonia.Models"
    xmlns:ToolTip="using:Avalonia.Controls"
    mc:Ignorable="d"
    x:Name="MainWindowElement"
    Title="THUAI9 调试界面"
    Width="1280"
    Height="800"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <DataTemplate x:Key="CharacterCardTemplate" x:DataType="vm:CharacterViewModel">
            <Border Background="White" CornerRadius="5" Padding="8,6" Margin="0,3">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="{Binding Name}"
                               FontSize="13"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding PlayerText}"
                               FontSize="10"
                               Foreground="#666666"
                               Margin="10,0,0,0"
                               HorizontalAlignment="Right" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="{Binding HealthText}"
                               FontSize="10"
                               Foreground="#666666" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding Coordinates}"
                               IsVisible="{Binding ShowCoordinates}"
                               FontSize="9"
                               Foreground="#777777"
                               HorizontalAlignment="Right"
                               Margin="10,0,0,0" />
                    <TextBlock Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Text="{Binding ActiveState}"
                               FontSize="10"
                               Foreground="#333333"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.SecondaryButton">
            <Setter Property="Background" Value="#E1DFDD" />
            <Setter Property="Foreground" Value="#201F1E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.SecondaryButton:pointerover">
            <Setter Property="Background" Value="#C7C6C5" />
        </Style>
        <Style Selector="Button.SecondaryButton:pressed">
            <Setter Property="Background" Value="#8D8C8C" />
        </Style>

        <Style Selector="Button.PlayButton">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D1D1D1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.PlayButton:pointerover">
            <Setter Property="Background" Value="#F3F3F3" />
            <Setter Property="BorderBrush" Value="#B8B8B8" />
        </Style>
        <Style Selector="Button.PlayButton:pressed">
            <Setter Property="Background" Value="#E1E1E1" />
            <Setter Property="BorderBrush" Value="#9D9D9D" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="470,*" Margin="10">
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,10,0">
            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,96,120" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 x:Name="PlaybackPathBox"
                                 Text="{Binding PlaybackVM.FilePath, Mode=TwoWay}"
                                 PlaceholderText="选择 .thuaipb 回放文件或粘贴路径" />
                        <Button Grid.Column="1"
                                Content="选择文件"
                                Click="BrowsePlayback_Click"
                                Classes="SecondaryButton"
                                Height="35" />
                        <Button Grid.Column="2"
                                Content="加载回放"
                                Command="{Binding LoadPlaybackCommand}"
                                CommandParameter="{Binding Text, ElementName=PlaybackPathBox}"
                                Classes="SecondaryButton"
                                Height="35" />
                    </Grid>

                    <Border Background="#E8E8E8" CornerRadius="5" Padding="8" Margin="0,5,0,0">
                        <Grid ColumnDefinitions="Auto,18,72,86,150,*" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <Button Content="播放"
                                    Command="{Binding PlaybackVM.PlayCommand}"
                                    Width="56"
                                    Height="35"
                                    VerticalAlignment="Center"
                                    Classes="PlayButton"
                                    ToolTip.Tip="播放" />

                            <Button Content="暂停"
                                    Command="{Binding PlaybackVM.PauseCommand}"
                                    Width="56"
                                    Height="35"
                                    VerticalAlignment="Center"
                                    Classes="PlayButton"
                                    ToolTip.Tip="暂停" />

                            <Button Content="停止"
                                    Command="{Binding PlaybackVM.StopCommand}"
                                    Width="56"
                                    Height="35"
                                    VerticalAlignment="Center"
                                    Classes="PlayButton"
                                    ToolTip.Tip="停止" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding PlaybackVM.PlaybackTimeText}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Width="72"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding PlaybackVM.PlaybackSpeedLabels}"
                                      SelectedIndex="{Binding PlaybackVM.PlaybackSpeedIndex, Mode=TwoWay}"
                                      Width="86"
                                      Height="34"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4"
                                       Text="{Binding PlaybackVM.FrameProgressText}"
                                       FontSize="11"
                                       Foreground="#666666"
                                       Width="150"
                                       TextAlignment="Left"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="*,*">
                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,4,4" Background="#FFF0F0" CornerRadius="5" Padding="10,8" BorderBrush="#FFCCCC" BorderThickness="1" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="7">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="队伍 1" FontSize="17" FontWeight="Bold" Foreground="Red" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding TeamScores[0], StringFormat='得分：{0}'}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="1" Background="#FFFFFFFF" CornerRadius="4" Padding="8,6">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="3" ColumnSpacing="12">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TeamOverviews[0].Material, StringFormat='原料：{0}'}" FontSize="11" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TeamOverviews[0].ComputePower, StringFormat='算力：{0}'}" FontSize="11" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding TeamOverviews[0].FactoryHp, StringFormat='工厂血量：{0}'}" FontSize="11" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="成员" FontSize="10" Foreground="#666666" />
                                <ScrollViewer Grid.Row="2" Grid.Column="1" MaxHeight="46" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{Binding TeamOverviews[0].MemberUuidText}" FontSize="9" Foreground="#666666" TextWrapping="Wrap" />
                                </ScrollViewer>
                                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="成员状态" FontSize="10" FontWeight="SemiBold" Foreground="#666666" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Team1Characters}"
                                          ItemTemplate="{StaticResource CharacterCardTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Margin="4,0,0,4" Background="#F0F0FF" CornerRadius="5" Padding="10,8" BorderBrush="#CCCCFF" BorderThickness="1" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="7">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="队伍 2" FontSize="17" FontWeight="Bold" Foreground="Blue" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding TeamScores[1], StringFormat='得分：{0}'}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="1" Background="#FFFFFFFF" CornerRadius="4" Padding="8,6">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="3" ColumnSpacing="12">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TeamOverviews[1].Material, StringFormat='原料：{0}'}" FontSize="11" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TeamOverviews[1].ComputePower, StringFormat='算力：{0}'}" FontSize="11" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding TeamOverviews[1].FactoryHp, StringFormat='工厂血量：{0}'}" FontSize="11" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="成员" FontSize="10" Foreground="#666666" />
                                <ScrollViewer Grid.Row="2" Grid.Column="1" MaxHeight="46" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{Binding TeamOverviews[1].MemberUuidText}" FontSize="9" Foreground="#666666" TextWrapping="Wrap" />
                                </ScrollViewer>
                                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="成员状态" FontSize="10" FontWeight="SemiBold" Foreground="#666666" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Team2Characters}"
                                          ItemTemplate="{StaticResource CharacterCardTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Margin="0,4,4,0" Background="#F0FFF0" CornerRadius="5" Padding="10,8" BorderBrush="#CCFFCC" BorderThickness="1" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="7">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="队伍 3" FontSize="17" FontWeight="Bold" Foreground="Green" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding TeamScores[2], StringFormat='得分：{0}'}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="1" Background="#FFFFFFFF" CornerRadius="4" Padding="8,6">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="3" ColumnSpacing="12">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TeamOverviews[2].Material, StringFormat='原料：{0}'}" FontSize="11" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TeamOverviews[2].ComputePower, StringFormat='算力：{0}'}" FontSize="11" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding TeamOverviews[2].FactoryHp, StringFormat='工厂血量：{0}'}" FontSize="11" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="成员" FontSize="10" Foreground="#666666" />
                                <ScrollViewer Grid.Row="2" Grid.Column="1" MaxHeight="46" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{Binding TeamOverviews[2].MemberUuidText}" FontSize="9" Foreground="#666666" TextWrapping="Wrap" />
                                </ScrollViewer>
                                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="成员状态" FontSize="10" FontWeight="SemiBold" Foreground="#666666" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Team3Characters}"
                                          ItemTemplate="{StaticResource CharacterCardTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Margin="4,4,0,0" Background="#FFFFF0" CornerRadius="5" Padding="10,8" BorderBrush="#FFFFCC" BorderThickness="1" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="7">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="队伍 4" FontSize="17" FontWeight="Bold" Foreground="Orange" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding TeamScores[3], StringFormat='得分：{0}'}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="1" Background="#FFFFFFFF" CornerRadius="4" Padding="8,6">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="3" ColumnSpacing="12">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding TeamOverviews[3].Material, StringFormat='原料：{0}'}" FontSize="11" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TeamOverviews[3].ComputePower, StringFormat='算力：{0}'}" FontSize="11" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding TeamOverviews[3].FactoryHp, StringFormat='工厂血量：{0}'}" FontSize="11" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="成员" FontSize="10" Foreground="#666666" />
                                <ScrollViewer Grid.Row="2" Grid.Column="1" MaxHeight="46" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{Binding TeamOverviews[3].MemberUuidText}" FontSize="9" Foreground="#666666" TextWrapping="Wrap" />
                                </ScrollViewer>
                                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="成员状态" FontSize="10" FontWeight="SemiBold" Foreground="#666666" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Team4Characters}"
                                          ItemTemplate="{StaticResource CharacterCardTemplate}" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Margin="0,5,0,0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="事件日志" FontWeight="Bold" Margin="0,0,0,3" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="160">
                        <ItemsControl ItemsSource="{Binding LogConsoleVM.LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogEntry">
                                    <Grid ColumnDefinitions="80,Auto,*" Margin="0,1">
                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp}" FontSize="9" Foreground="Gray" />
                                        <Border Grid.Column="1" CornerRadius="2" Padding="2,0" Margin="5,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Level, Converter={StaticResource LevelToColorConverter}, FallbackValue=LightGray}" />
                                            </Border.Background>
                                            <TextBlock Text="{Binding Level}" FontSize="8" Foreground="White" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="10" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="5" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" FontWeight="SemiBold" />
                </Border>

                <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="5" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="地图图例" FontWeight="Bold" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding MapLegendItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" ItemWidth="120" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:LegendItem">
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Border Width="15" Height="15" Background="{Binding Color}" BorderBrush="{Binding Stroke}" BorderThickness="{Binding BorderThickness}" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding Description}" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="5" BorderBrush="Gray" BorderThickness="1">
                <local:MapView x:Name="MapView" DataContext="{Binding MapVM}" />
            </Border>
        </Grid>
    </Grid>
</Window>
